# Drop duplicate PATH/fpath entries
typeset -U path fpath

# Prompt theme (subnixr/minimal; zgen was only used to load this one file)
source "${HOME}/.zgen/subnixr/minimal-master/minimal.zsh"

export EDITOR="nvim"

# Load separated config files
for conf in "$HOME/.dotfiles/config/zsh/config.d/"*.zsh; do
  source "${conf}"
done
unset conf

# Tab completion (full security check only once a day; otherwise use the cached dump)
setopt extendedglob             # needed for the (#q...) glob qualifier below
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit && touch ~/.zcompdump; else compinit -C; fi
setopt complete_in_word         # cd /ho/sco/tm<TAB> expands to /home/scott/tmp
setopt auto_menu                # show completion menu on successive tab presses
setopt autocd                   # cd to a folder just by typing its name
ZLE_REMOVE_SUFFIX_CHARS=$' \t\n;&' # These "eat" the auto prior space after a tab complete

# MISC
setopt interactive_comments     # allow # comments in shell; good for copy/paste
unsetopt correct_all            # I don't care for 'suggestions' from ZSH

# Download audio only, as mp3: podaudio <url>
alias podaudio="yt-dlp -f 'ba' -x --audio-format mp3 -o '%(title)s.%(ext)s'"

# Quick cd into iCloud Drive
alias icloud='cd ~/Library/Mobile\ Documents/com~apple~CloudDocs'
alias prd="pnpm run dev"

# Re-apply dedupe (export PATH=... assignments bypass typeset -U)
path=($path)
