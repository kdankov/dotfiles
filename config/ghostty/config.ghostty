# Ghostty config
# Reload after editing with cmd+shift+, (or restart Ghostty).

# ── font ──────────────────────────────────────────────────────────────────
# The installed family is "FiraCode Nerd Font Mono" (see `ghostty +list-fonts`).
# Bold, italic and bold-italic faces are resolved from it automatically.
font-family = FiraCode Nerd Font Mono
font-size = 16

# ── colors ────────────────────────────────────────────────────────────────
theme = Catppuccin Macchiato

# Overrides on top of the built-in theme: bright 9-14 reuse the normal hues
# (Ghostty's built-in brightens them), and the selection uses rosewater.
# Delete this block to get Ghostty's stock Catppuccin look instead.
palette = 9=#ed8796
palette = 10=#a6da95
palette = 11=#eed49f
palette = 12=#8aadf4
palette = 13=#f5bde6
palette = 14=#8bd5ca
selection-background = #f4dbd6
selection-foreground = #24273a

# ── window ────────────────────────────────────────────────────────────────
window-padding-x = 15
window-padding-y = 10
window-padding-balance = true
background-opacity = 1

# Titlebar fully hidden, but the native window frame and rounded corners are
# kept (this is what `window-decoration = none` would have thrown away).
# Window buttons are always hidden in this mode. There's no titlebar left to
# grab, so move the window with option+click; edges still resize normally.
macos-titlebar-style = hidden

# ── shell / terminal ──────────────────────────────────────────────────────
# Ghostty's own terminfo (xterm-ghostty) unlocks features this hides; drop
# this line if you don't need the compatibility.
term = xterm-256color

# Scrollback is budgeted in BYTES per surface (default 10000000 = 10MB).
# ~100MB keeps very long history; lower it if memory use bothers you.
scrollback-limit = 100000000

# ── keybinds ──────────────────────────────────────────────────────────────
keybind = ctrl+digit_6=text:\x1e
keybind = shift+enter=text:>

# Middle-click paste is always enabled, and copy-on-select defaults to true.
